# ==============================================
# Procesador de Albaranes - Variables de entorno
# ==============================================
# Copia este archivo como .env y rellena los valores

# ---- Anthropic Claude API (OBLIGATORIO) ----
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# ---- Modelo de Claude ----
# Opciones: claude-3-5-haiku-latest (rápido/barato) | claude-3-5-sonnet-latest (mejor calidad)
CLAUDE_MODEL=claude-3-5-haiku-latest

# ---- Base de datos ----
DATABASE_URL=sqlite:////data/app.db

# ---- Almacenamiento de archivos ----
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports
MAX_UPLOAD_SIZE_MB=20

# ---- URL de la aplicación (para QR codes) ----
# Cambia esto por tu dominio/IP en producción
BASE_URL=http://localhost:3000

# ---- OCR ----
TESSERACT_LANG=spa+eng
